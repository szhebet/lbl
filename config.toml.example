[server]
#port = 9091
bind = "0.0.0.0"
enable_delete = true
log_level = "info"
# Секретный ключ для подписи JWT-токенов. ОБЯЗАТЕЛЬНО замените на свой случайный ключ перед запуском.
# Сгенерировать: openssl rand -hex 32
jwt_secret = "CHANGE_ME_TO_A_RANDOM_SECRET_KEY"
#token_ttl = 24  # hours; 0 (or commented out) = no expiration
# Внешний URL этого сервера, под которым его видят соседние серверы федерации
# (используется как идентификатор отправителя в рассылке запросов и для
# ответного предложения книги). Например: https://mylib.example:444
#public_url = ""

[directories]
bookarch = "bookarch"
temp = "tempfld"
logs = "logs"
templates = "templates"
static = "static"
#apk_dir = "apk"               # APK files for auto-update (library.apk + version.txt)
#backup = "/var/backups/library"  # Must be set for DB migrations to work

[database]
#host = "localhost"
#port = 5432
#name = "library"
#user = "postgres"
#password = "PASSWORD"
sslmode = "disable"
#pgdata = "/var/lib/postgresql/data"

[llm]
base_url = "http://192.168.1.2:11434"
model = "phi4:latest"
token = ""
timeout = 60
prompt = "По тексту первых страниц книги определи автора и название. Ответь строго в две строки на русском языке:\nAUTHOR: Имя автора1, Имя автора2\nBOOKNAME: Полное название книги. Если авторов несколько - раздели их ФИО запятой. Если имя автора или название определить не удалось - верни пустое значение в соответствующей строке."
prompt2= "По фрагменту текста определи автора и название книги. Ответь строго в две строки на русском языке:\nAUTHOR: Имя автора\nBOOKNAME: Полное название книги. Если авторов несколько - раздели их ФИО запятой. Если имя автора или название определить не удалось - верни пустое значение в соответствующей строке."
prompt_convert = "Преобразуй к формату Автор - Название произведения следующий текст. Ответь строго по формату, без лишних рассуждений. Одно произведение - одна строка: не объединяй несколько произведений в одной строке и не добавляй пояснений, списков и пустых строк. Имя автора при необходимости продублируй. Текст для преобразования: \n"

[federation]
# Рассылка пользовательских запросов книг на соседние серверы федерации.
# Каждые push_interval_sec секунд фоновый поток собирает все запросы книг
# (позиции «Запросы» у пользователей) и отправляет их на каждый зарегистрированный
# соседний сервер (api_neighbours) с подтверждением получения.
enabled = true
push_interval_sec = 300      # как часто фоновый поток пишет запросы соседям
retry_interval_sec = 60      # пауза между повторами для недоступного сервера
retry_window_sec = 3600      # сколько времени повторять, прежде чем сдаться
