# Dockerfile for Android APK build
# Requires library-app-android-sdk:latest (build with build-apk-sdk.sh)
# Build context: project root (.)
FROM library-app-android-sdk:latest

WORKDIR /app

# Copy source code
COPY src_android/ .

# Build APKs with Gradle cache mount (prevents re-download on every build)
ENV GRADLE_OPTS="-Dhttps.protocols=TLSv1.2 -Djdk.tls.client.protocols=TLSv1.2 -Dorg.gradle.internal.http.connectionTimeout=120000 -Dorg.gradle.internal.http.socketTimeout=120000"
RUN --mount=type=cache,target=/root/.gradle/caches,sharing=shared \
    --mount=type=cache,target=/root/.gradle/wrapper,sharing=shared \
    gradle assembleDebug assembleRelease --no-daemon -x lint -x lintVitalAnalyzeRelease -x lintVitalReportRelease -x lintVitalRelease

# Extract APKs
RUN mkdir -p /output && \
    cp app/build/outputs/apk/debug/app-debug.apk /output/ 2>/dev/null || true && \
    cp app/build/outputs/apk/release/app-release.apk /output/ 2>/dev/null || true

CMD ["echo", "APKs in /output/"]
