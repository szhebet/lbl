<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for TWA.
    Trusts the self-signed CA certificate bundled in raw resources
    and allows cleartext for local development.
-->
<network-security-config>
    <!-- Trust the bundled CA certificate for HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">192.168.95.200</domain>
        <trust-anchors>
            <certificates src="@raw/ca_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext (HTTP) for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>

    <!-- Base config: trust system certificates -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
