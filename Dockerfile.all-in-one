FROM postgres:17-alpine

ENV POSTGRES_USER=library
ENV POSTGRES_PASSWORD=library_secret
ENV POSTGRES_DB=librarydb

COPY db/scripts/init_db.sql /docker-entrypoint-initdb.d/01-init_db.sql

RUN apk add --no-cache go ca-certificates bash

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY src/ ./src/
COPY opds.go ./
RUN go build -o library_app ./src/main.go ./src/opds.go

COPY static/ ./static/
COPY templates/ ./templates/
COPY bookarch/ ./bookarch/
COPY tempfld/ ./tempfld/

COPY startup.sh ./
RUN chmod +x startup.sh

ENV PORT=8080
ENV DATABASE_URL=host=localhost port=5432 user=library password=library_secret dbname=librarydb sslmode=disable

EXPOSE 5432 8080

CMD ["./startup.sh"]